# ==============================================================================
# Portfolio Hub (.gitignore)
# ==============================================================================

# --- Archives & Deployment Backups ---
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak

# --- Python & Testing Artifacts ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
devpath/scratch/
devpath/tests/__pycache__/
devpath/tests/*.png

# --- Sandbox Prototyping & Verification Probes ---
sandbox/_*.mjs

# --- Temporary Files & Error Logs ---
*.log
console.error*
*.tmp
*.temp

# --- Local IDE & Editor Metadata ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating System Files ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# --- Environment & Secret Protections ---
.env
.env.*
*.pem
*.key
*.cert
*service-account*.json
*serviceAccount*.json
secrets/
credentials/

# --- Private & Non-Hub Root Directories ---
anniversary/
aspnet_client/

# --- Local Browser Automation & QA Artifacts ---
# Scratch output from local headless-browser checks (CDP/pywebview runs):
# throwaway Edge profiles, verification scripts, screenshots, and JSON dumps.
# These live only on the developer machine and are safe to regenerate.
.tmp-edge-profile*/
.tmp-chrome-profile*/
.tmp-*.js
.tmp-*.mjs
.tmp-*.py
.tmp-*.ps1
.tmp-*.json
.tmp-*.html
.tmp-*.txt
.tmp-*.png
.tmp-*.jpg
.tmp-*.jpeg
.tmp-*.webp
.tmp-*.gif
.tmp-*.log
.tmp-shots/
.tmp-public-resume/
.tmp-clean/
# Playwright / test-runner output directories
playwright-report/
test-results/
# Local tool caches
.cache/
.coverage/
